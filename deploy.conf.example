# === 语音聊天室部署配置 ===
# 复制此文件为 deploy.conf 并填写你的实际值
#   cp deploy.conf.example deploy.conf
#
# 重要: deploy.conf 包含敏感信息，不会被提交到 Git

# --- 服务器 ---
# 后端服务器 (运行 MongoDB + Mediasoup)
PUBLIC_IP_BACKEND=""
DOMAIN_BACKEND=""

# 前端服务器 (运行 Nginx 静态文件)
PUBLIC_IP_FRONTEND=""
DOMAIN_FRONTEND=""

# --- 管理员 ---
ADMIN_PASSWORD=""

# --- CORS ---
# 与 DOMAIN_FRONTEND 一致
CORS_ORIGIN=""

# --- 容器端口 (保持默认即可) ---
MONGO_PORT="27017"
MONGO_DB_NAME="voice-chat-prod"
BACKEND_PORT="3001"
BACKEND_HOST="0.0.0.0"
NGINX_PORT="8080"
RTC_MIN_PORT="40000"
RTC_MAX_PORT="49999"
MEDIASOUP_LISTEN_IP="0.0.0.0"
